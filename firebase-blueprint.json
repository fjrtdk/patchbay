{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document storing basic user metadata",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase user UID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "Profile photo URL",
          "maxLength": 512
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last profile update timestamp"
        }
      },
      "required": ["id", "createdAt", "updatedAt"]
    },
    "NetworkTopology": {
      "title": "NetworkTopology",
      "description": "Homelab topology diagram with nodes and edges",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Topology document ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Topology name",
          "maxLength": 100
        },
        "nodes": {
          "type": "array",
          "description": "Network graph nodes array"
        },
        "edges": {
          "type": "array",
          "description": "Network graph edges array"
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether this is the user's active/default diagram"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "userId", "name", "createdAt", "updatedAt"]
    },
    "DiscoveryScan": {
      "title": "DiscoveryScan",
      "description": "Saved discovery scan log",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Scan document ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Scan title or label",
          "maxLength": 100
        },
        "rawText": {
          "type": "string",
          "description": "Raw terminal scan text or nmap output",
          "maxLength": 20000
        },
        "nodeCount": {
          "type": "number",
          "description": "Number of parsed items discovered"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "userId", "title", "rawText", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles"
    },
    "/users/{userId}/topologies/{topologyId}": {
      "schema": "NetworkTopology",
      "description": "User network diagrams and homelab configurations"
    },
    "/users/{userId}/scans/{scanId}": {
      "schema": "DiscoveryScan",
      "description": "User saved discovery scans"
    }
  }
}
