rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net - default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id == request.auth.uid &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNetworkTopology(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'name', 'nodes', 'edges', 'isDefault', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        (!('nodes' in data) || (data.nodes is list && data.nodes.size() <= 500)) &&
        (!('edges' in data) || (data.edges is list && data.edges.size() <= 1000)) &&
        (!('isDefault' in data) || data.isDefault is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDiscoveryScan(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'rawText', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'rawText', 'nodeCount', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
        data.rawText is string && data.rawText.size() <= 25000 &&
        (!('nodeCount' in data) || data.nodeCount is number) &&
        data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if false;

      match /topologies/{topologyId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidId(topologyId) &&
          isValidNetworkTopology(incoming(), userId) &&
          incoming().id == topologyId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isOwner(userId) &&
          isValidId(topologyId) &&
          isValidNetworkTopology(incoming(), userId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time;
        allow delete: if isOwner(userId) && isValidId(topologyId);
      }

      match /scans/{scanId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidId(scanId) &&
          isValidDiscoveryScan(incoming(), userId) &&
          incoming().id == scanId &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(scanId);
      }
    }
  }
}
